   "fieldname": "connection_string",
   "fieldtype": "Text",
   "label": "Connection String"
  },
  {
   "depends_on": "eval:doc.database_type == \"DuckDB\"",
   "description": "Headers sent when attaching an http(s) DuckDB database, as a JSON object.",
   "fieldname": "http_headers",
   "fieldtype": "JSON",
   "label": "HTTP Headers"
  },
  {
   "default": "0",

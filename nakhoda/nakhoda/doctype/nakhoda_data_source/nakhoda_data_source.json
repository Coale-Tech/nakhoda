 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Title",
   "reqd": 1
  },
  {
   "default": "Site Database",
   "description": "Site Database queries the site's own tables live. DuckDB Warehouse queries the synced local copy. External Database queries a server you configure below.",
   "fieldname": "source_type",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Source Type",
   "options": "Site Database\nDuckDB Warehouse\nExternal Database",
   "reqd": 1
  },
  {
   "default": "0",
   "fieldname": "is_default",
   "fieldtype": "Check",
   "in_list_view": 1,
   "label": "Default Source"
  },
  {
   "fieldname": "column_break_state",
   "fieldtype": "Column Break"
  },
  {
   "default": "Untested",
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Untested\nReachable\nUnreachable",
   "read_only": 1
  },
  {
   "fieldname": "last_checked",
   "fieldtype": "Datetime",
   "label": "Last Checked",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.source_type == \"External Database\"",
   "fieldname": "connection_section",
   "fieldtype": "Section Break",
   "label": "Connection"
  },
  {
   "default": "MariaDB",
   "depends_on": "eval:doc.source_type == \"External Database\"",
   "description": "Which engine this server runs. Determines the driver and the SQL dialect the compiler emits.",
   "fieldname": "database_type",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Database Type",
   "options": "MariaDB\nPostgreSQL\nClickHouse\nDuckDB\nSQLite"
  },
  {
   "depends_on": "eval:doc.source_type == \"External Database\" && !['DuckDB', 'SQLite'].includes(doc.database_type)",
   "fieldname": "host",
   "fieldtype": "Data",
   "label": "Host"
  },
  {
   "depends_on": "eval:doc.source_type == \"External Database\" && !['DuckDB', 'SQLite'].includes(doc.database_type)",
   "fieldname": "port",
   "fieldtype": "Int",
   "label": "Port",
   "non_negative": 1
  },
  {
   "default": "0",
   "depends_on": "eval:doc.source_type == \"External Database\" && !['DuckDB', 'SQLite'].includes(doc.database_type)",
   "fieldname": "use_ssl",
   "fieldtype": "Check",
   "label": "Use SSL"
  },
  {
   "fieldname": "column_break_credentials",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.source_type == \"External Database\"",
   "description": "For DuckDB, a file name under the site's private files, or an http(s) URL to attach. For SQLite, a file name under the site's private files.",
   "fieldname": "database_name",
   "fieldtype": "Data",
   "label": "Database Name"
  },
  {
   "depends_on": "eval:doc.source_type == \"External Database\" && !['DuckDB', 'SQLite'].includes(doc.database_type)",
   "fieldname": "username",
   "fieldtype": "Data",
   "label": "Username"
  },
  {
   "depends_on": "eval:doc.source_type == \"External Database\" && !['DuckDB', 'SQLite'].includes(doc.database_type)",
   "fieldname": "password",
   "fieldtype": "Password",
   "label": "Password"
  },
  {
   "depends_on": "eval:doc.database_type == \"PostgreSQL\"",
   "description": "Comma-separated for more than one. Defaults to public.",
   "fieldname": "schema",
   "fieldtype": "Data",
   "label": "Schema"
  },
  {
   "collapsible": 1,
   "depends_on": "eval:doc.source_type == \"External Database\"",
   "fieldname": "advanced_section",
   "fieldtype": "Section Break",
   "label": "Advanced"
  },
  {

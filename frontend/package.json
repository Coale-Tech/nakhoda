		"vega-lite": "^6.4.1",
		"vue": "^3.5.13",
		"vue-router": "^4.5.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@vitejs/plugin-vue": "^5.2.1",
		"autoprefixer": "^10.4.20",
